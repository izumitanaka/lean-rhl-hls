import IRComparison.Circuit.RTL.InterfaceSyntax

namespace IRComparison.Circuit.SystemVerilog

/-- Identifiers are generated, never interpolated from user text. Separate
constructors keep storage, temporary nets, and external ports distinct. -/
inductive Name where
  | temporary (id : Nat) | holding (id : Nat) | register (id : Nat)
  | memory (id : Nat) | length (id : Nat) | queue (id : Nat) | used (id : Nat)
  | pc | busy | done | error | x | y | configData | configAddress | configId | configRegister
  | loopIndex | shiftIndex (queue : Nat)
  deriving Repr, DecidableEq

def Name.text : Name → String
  | .temporary n => s!"e{n}"
  | .holding n => s!"w{n}"
  | .register n => s!"r{n}"
  | .memory n => s!"m{n}"
  | .length n => s!"len{n}"
  | .queue n => s!"q{n}"
  | .used n => s!"used{n}"
  | .pc => "pc" | .busy => "busy" | .done => "done" | .error => "error"
  | .x => "x" | .y => "y" | .configData => "cfg_data" | .configAddress => "cfg_addr"
  | .configId => "cfg_id" | .configRegister => "cfg_reg"
  | .loopIndex => "j" | .shiftIndex q => s!"shift{q}"

inductive Operator where
  | add | sub | mul | div | mod | lt | ge | eq | ne | and
  deriving Repr, DecidableEq

def Operator.text : Operator → String
  | .add => "+" | .sub => "-" | .mul => "*" | .div => "/" | .mod => "%"
  | .lt => "<" | .ge => ">=" | .eq => "==" | .ne => "!=" | .and => "&&"

/-- Concrete expression constructors of the emitted subset. Division here is
native signed truncation, not Lean's Euclidean division. Its correction must
be expressed using these ordinary operators before serialization. -/
inductive Expr where
  | reference (name : Name)
  | index (name : Name) (address : Expr)
  | integer (value : Nat)
  | literal (width : Nat) (value : Int) (positive : 0 < width)
  | bit (value : Bool)
  | unsigned (value : Expr)
  | cast (width : Nat) (value : Expr) (positive : 0 < width)
  | binary (op : Operator) (left right : Expr)
  | select (condition yes no : Expr)
  deriving Repr, DecidableEq

def Expr.text : Expr → String
  | .reference name => name.text
  | .index name address => s!"{name.text}[{address.text}]"
  | .integer n => s!"{bits n+1}'sd{n}"
  | .literal w n _ => s!"{w}'sd{(BitVec.ofInt w n).toNat}"
  | .bit b => if b then "1'b1" else "1'b0"
  | .unsigned e => "$signed({1'b0," ++ e.text ++ "})"
  | .cast w e _ => s!"$signed({w}'({e.text}))"
  | .binary op a b => s!"({a.text} {op.text} {b.text})"
  | .select c a b => s!"({c.text} ? {a.text} : {b.text})"

structure Wire where
  name : Name
  width : Nat
  value : Expr
  positive : 0 < width
  deriving Repr

def Wire.text (w : Wire) := s!"  wire signed [{w.width-1}:0] {w.name.text} = {w.value.text};"

/-- Euclidean correction built from actual SystemVerilog operations. -/
def division (x y : Expr) : Expr :=
  .select (.binary .eq y (.integer 0)) (.integer 0)
    (.select (.binary .and (.binary .lt x (.integer 0)) (.binary .ne (.binary .mod x y) (.integer 0)))
      (.select (.binary .lt (.integer 0) y)
        (.binary .sub (.binary .div x y) (.integer 1))
        (.binary .add (.binary .div x y) (.integer 1)))
      (.binary .div x y))

inductive Destination where
  | reference (name : Name)
  | index (name : Name) (address : Expr)
  deriving Repr

def Destination.text : Destination → String
  | .reference name => name.text
  | .index name address => s!"{name.text}[{address.text}]"

/-- Only the clocked-statement fragment currently generated by this backend.
The loop loopVar belongs to elaboration of a fixed bank-update template;
all assignments in its body remain nonblocking. -/
inductive Statement where
  | skip
  | assign (target : Destination) (value : Expr)
  | seq (first second : Statement)
  | branch (condition : Expr) (yes no : Statement)
  | forRange (loopVar : Name) (count : Nat) (body : Statement)
  deriving Repr

def Statement.text : Statement → String
  | .skip => ""
  | .assign target value => s!"{target.text} <= {value.text};"
  | .seq a b => a.text ++ " " ++ b.text
  | .branch c a b => s!"if ({c.text}) begin {a.text} end else begin {b.text} end"
  | .forRange v n body => s!"for (reg [{bits n-1}:0] {v.text}=0;{v.text}<{(Expr.integer n).text};{v.text}={v.text}+1) begin {body.text} end"

end IRComparison.Circuit.SystemVerilog
