import IRComparison.Frontend.WordStepCompleteness

/-! Elaboration inserts a `pure () >>= ...` administrative continuation in
ordinary `for` bodies. It is normalized without adding a source operation. -/
namespace IRComparison.WordFrontend.Certificate.Step
open Lean4Lean LeanTyped LeanTypeInference

def equalityPrefix (plain : VExpr) : VExpr :=
  .app (.app (.const ``Eq [.succ .zero]) (optionType stepState)) (lifted plain)

theorem equalityPrefix_typed (signatures : Signatures env)
    (eqDeclared : env.constants ``Eq = some eqSignature)
    (plainTyped : CastTyping env 0 casts ctx plain (optionType stateType)) :
    CastTyping env 0 casts ctx (equalityPrefix plain)
      (.forallE (optionType stepState) (.sort .zero)) := by
  have optionTyped : DirectTyping env 0 ctx (.const ``Option [.zero])
      (.forallE (.sort (.succ .zero)) (.sort (.succ .zero))) :=
    .constant signatures.option (by simp [VLevel.WF]) rfl
  have eqTyped : DirectTyping env 0 ctx (.const ``Eq [.succ .zero]) (eqSignature.type.instL [.succ .zero]) :=
    .constant eqDeclared (by simp [VLevel.WF]) rfl
  have eqHead := DirectTyping.application eqTyped (DirectTyping.application optionTyped signatures.step_typed)
  simp only [eqSignature,VExpr.instL,VLevel.inst,VExpr.inst,VExpr.instVar_zero,VExpr.instVar_succ,
    VExpr.instVar_lower,Nat.reduceAdd,VExpr.lift,VExpr.liftN,optionType,stepState,stateType,List.map_nil] at eqHead
  have liftTyped : CastTyping env 0 casts ctx (.const ``WordLoopFacts.lift []) liftSignature :=
    .constant signatures.liftDecl (by simp) rfl
  have lifted := CastTyping.application liftTyped plainTyped
  simpa only [equalityPrefix,liftSignature,lifted,VExpr.inst,optionType,stepState,stateType] using
    CastTyping.application (eqHead.withCasts casts) lifted

end IRComparison.WordFrontend.Certificate.Step

namespace IRComparison.WordFrontend.Certificate.UnitStep
open Lean4Lean LeanTyped LeanTypeInference LeanTypeReduction
open Arithmetic (SourceCasts)
set_option maxHeartbeats 1200000

def unitType : VExpr := .const ``PUnit [.succ .zero]
def unitValue : VExpr := .const ``PUnit.unit [.succ .zero]
def nativeUnitType : Lean.Expr := .const ``PUnit [.succ .zero]
def nativeUnitValue : Lean.Expr := .const ``PUnit.unit [.succ .zero]
def unitSignature : VConstant := ⟨1,.sort (.param 0)⟩
def valueSignature : VConstant := ⟨1,.const ``PUnit [.param 0]⟩

structure Signatures (env : VEnv) : Prop where
  typeDecl : env.constants ``PUnit = some unitSignature
  valueDecl : env.constants ``PUnit.unit = some valueSignature

theorem Signatures.type_typed (signatures : Signatures env) :
    DirectTyping env 0 ctx unitType (.sort (.succ .zero)) :=
  .constant signatures.typeDecl (by simp [VLevel.WF]) rfl

theorem Signatures.value_typed (signatures : Signatures env) :
    DirectTyping env 0 ctx unitValue unitType :=
  .constant signatures.valueDecl (by simp [VLevel.WF]) rfl

/-- The reduction theorem also covers a literal argument, not just the bound
variable used by state/value continuations. Equality is handled by reflexivity
if substitution happens to leave the term unchanged. -/
theorem beta_at_proved (setup : Arithmetic.AliasSetup env) (arithmetic : Arithmetic.Signatures env)
    (closed : ClosedConstantTypes env) {body : VExpr}
    (bodyTyped : CastTyping env 0 (SourceCasts env) (domain::ctx) body resultType)
    (argTyped : CastTyping env 0 (SourceCasts env) ctx arg domain)
    (notSort : ∀ u, resultType.inst arg ≠ .sort u)
    (form : Arithmetic.ValueForm setup ctx (body.inst arg) (resultType.inst arg)) (fuel : Nat) :
    ∃ equation, LeanStructuralConversion.prove env setup.basic setup.exposure 0 (fuel+5) ctx
      (body.inst arg) (.app (.lam domain body) arg) = some equation ∧ equation.type = resultType.inst arg := by
  have baseNone := setup.basic_beta_none bodyTyped notSort form
  by_cases same : body.inst arg = .app (.lam domain body) arg
  · have typed := bodyTyped.instantiate closed SourceCasts.closed argTyped
    rw [← same] at baseNone ⊢
    exact LeanStructuralConversion.prove_reflexive_cast_complete typed baseNone
      (setup.covers_source_recursive arithmetic closed fuel)
  · exact LeanStructuralConversion.prove_beta_right_cast_complete bodyTyped argTyped
      (setup.covers_source_recursive arithmetic closed fuel)
      (by intro result step; exact form.step_kind _ _ step) same baseNone

/-- Conversion of the proof premise generated by the Unit normalization rule.
The substituted source is typed independently of the conversion search. -/
theorem premise_conversion (setup : Arithmetic.AliasSetup env) (arithmetic : Arithmetic.Signatures env)
    (steps : Step.Signatures env) (units : Signatures env) (closed : ClosedConstantTypes env) {body : VExpr}
    (plainTyped : CastTyping env 0 (SourceCasts env) ctx plain (optionType stateType))
    (bodyTyped : CastTyping env 0 (SourceCasts env) (unitType::ctx) body (optionType Step.stepState))
    (sourceForm : Arithmetic.ValueForm setup ctx (body.inst unitValue) (optionType Step.stepState))
    (eqDeclared : env.constants ``Eq = some eqSignature)
    (eqFresh : ∀ r ∈ setup.rules, ``Eq ≠ r.name) :
    ∃ result, setup.conversion 0 ctx (Step.expected plain (body.inst unitValue))
      (Step.expected plain (.app (.lam unitType body) unitValue)) = some result := by
  have prefixTyped := Step.equalityPrefix_typed steps eqDeclared plainTyped
  have prefixNone : setup.basic 0 ctx (Step.equalityPrefix plain) (Step.equalityPrefix plain) = none :=
    setup.basic_no_reduction _ _ rfl rfl eqFresh eqFresh rfl
  have wholeNone : setup.basic 0 ctx (Step.expected plain (body.inst unitValue))
      (Step.expected plain (.app (.lam unitType body) unitValue)) = none :=
    setup.basic_no_reduction _ _ rfl rfl eqFresh eqFresh rfl
  have substitutionTyped := bodyTyped.instantiate closed SourceCasts.closed (units.value_typed.withCasts _)
  simp only [optionType,Step.stepState,stateType,VExpr.inst] at substitutionTyped
  by_cases same : body.inst unitValue = .app (.lam unitType body) unitValue
  · have eqTyped := CastTyping.application prefixTyped substitutionTyped
    simp only [optionType,Step.stepState,stateType,VExpr.inst] at eqTyped
    rw [← same] at wholeNone ⊢
    obtain ⟨equation,proved,kind⟩ := LeanStructuralConversion.prove_reflexive_cast_complete eqTyped wholeNone
      (setup.covers_source_recursive arithmetic closed 59)
    exact LeanStructuralConversion.conversion_of_prove equation proved kind
  · obtain ⟨prefixEq,prefixProved,prefixType⟩ := LeanStructuralConversion.prove_reflexive_cast_complete prefixTyped prefixNone
      (setup.covers_source_recursive arithmetic closed 58)
    obtain ⟨value,valueProved,valueType⟩ := beta_at_proved setup arithmetic closed bodyTyped
      (units.value_typed.withCasts _) (by intro u; simp [optionType,Step.stepState,stateType,VExpr.inst])
      (by simpa only [optionType,Step.stepState,stateType,VExpr.inst] using sourceForm) 58
    simp only [optionType,Step.stepState,stateType,VExpr.inst] at valueType
    obtain ⟨equation,proved,kind⟩ := LeanStructuralConversion.prove_application_complete
      (leftName := ``Eq) (rightName := ``Eq) rfl rfl (fun h => same (VExpr.app.inj h).2)
      wholeNone prefixEq prefixProved prefixType value valueProved valueType
    exact LeanStructuralConversion.conversion_of_prove equation proved kind

end IRComparison.WordFrontend.Certificate.UnitStep
