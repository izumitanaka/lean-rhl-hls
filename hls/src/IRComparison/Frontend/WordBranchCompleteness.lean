import IRComparison.Frontend.WordBodyCompleteness

/-! Composition of the existing nonzero conditional. The predicate and its
Decidable term are represented and independently typed; no successful
compiler or typechecker execution is assumed for them. -/
namespace IRComparison.WordFrontend.Certificate.Branch
open Lean4Lean LeanTyped LeanTypeInference
variable {casts proofCasts : TypeCasts} [Arithmetic.Includes casts] [Arithmetic.Includes proofCasts]
set_option maxHeartbeats 1200000

def testHeader : VExpr := applications (.const ``bne [.zero])
  [wordType,applications (.const ``instBEqOfDecidableEq [.zero])
    [wordType,.app (.const ``instDecidableEqBitVec []) Arithmetic.width]]
def nativeTestHeader : Lean.Expr := Lean.mkApp2 (.const ``bne [.zero]) word
  (Lean.mkApp2 (.const ``instBEqOfDecidableEq [.zero]) word
    (.app (.const ``instDecidableEqBitVec []) Arithmetic.nativeWidth))
theorem testHeader_represents : Represents nativeTestHeader testHeader :=
  .app (.app (.constant rfl) (.constant rfl))
    (.app (.app (.constant rfl) (.constant rfl)) (.app (.constant rfl) Arithmetic.width_represents))

def condition (v : VExpr) : VExpr := equalValues (.const ``Bool [])
  (applications testHeader [v,Arithmetic.literalTerm 0]) (.const ``Bool.true [])
def nativeCondition (v : Lean.Expr) : Lean.Expr := Lean.mkApp3 (.const ``Eq [.succ .zero])
  (.const ``Bool []) (Lean.mkApp2 nativeTestHeader v (Arithmetic.nativeLiteral 0)) (.const ``Bool.true [])
theorem condition_represents (value : Represents v vc) : Represents (nativeCondition v) (condition vc) :=
  .app (.app (.app (.constant rfl) (.constant rfl))
    (.app (.app testHeader_represents value) (Arithmetic.literal_represents 0))) (.constant rfl)
theorem condition_inst (v arg : VExpr) (k : Nat) :
    (condition v).inst arg k = condition (v.inst arg k) := by
  have hc : testHeader.ClosedN 0 := testHeader_represents.closed 0 rfl
  have zc : (Arithmetic.literalTerm 0).ClosedN 0 :=
    (Arithmetic.literal_represents 0).closed 0 rfl
  simp only [condition,equalValues,applications,VExpr.inst,
    hc.instN_eq (Nat.zero_le k),zc.instN_eq (Nat.zero_le k)]

/-- Fixed standard declarations generated by Lean for `if v != 0`.
They are loaded from the ordinary environment once, not supplied per branch. -/
def bneSignature : VConstant := ⟨1,.forallE (.sort (.succ (.param 0)))
  (.forallE (.app (.const ``BEq [.param 0]) (.bvar 0))
    (.forallE (.bvar 1) (.forallE (.bvar 2) Arithmetic.boolType)))⟩
def beqInstanceSignature : VConstant := ⟨1,.forallE (.sort (.succ (.param 0)))
  (.forallE (.app (.const ``DecidableEq [.succ (.param 0)]) (.bvar 0))
    (.app (.const ``BEq [.param 0]) (.bvar 1)))⟩
def bitvecDecisionSignature : VConstant := ⟨0,.forallE Arithmetic.natType
  (.app (.const ``DecidableEq [.succ .zero]) (.app (.const ``BitVec []) (.bvar 0)))⟩
def boolDecisionSignature : VConstant :=
  ⟨0,.app (.const ``DecidableEq [.succ .zero]) Arithmetic.boolType⟩

structure BooleanLibrary (env : VEnv) : Prop where
  boolean : env.constants ``Bool = some ⟨0,.sort (.succ .zero)⟩
  truth : env.constants ``Bool.true = some ⟨0,Arithmetic.boolType⟩
  equality : env.constants ``Eq = some eqSignature
  decidable : env.constants ``Decidable = some Arithmetic.decidableSignature
  decidableEq : env.constants ``DecidableEq = some Arithmetic.decEqSignature
  bneMethod : env.constants ``bne = some bneSignature
  beqInstance : env.constants ``instBEqOfDecidableEq = some beqInstanceSignature
  bitvecInstance : env.constants ``instDecidableEqBitVec = some bitvecDecisionSignature
  boolInstance : env.constants ``instDecidableEqBool = some boolDecisionSignature

def booleanDecision (v : VExpr) : VExpr := applications (.const ``instDecidableEqBool [])
  [applications testHeader [v,Arithmetic.literalTerm 0],.const ``Bool.true []]
def nativeBooleanDecision (v : Lean.Expr) : Lean.Expr := Lean.mkApp2 (.const ``instDecidableEqBool [])
  (Lean.mkApp2 nativeTestHeader v (Arithmetic.nativeLiteral 0)) (.const ``Bool.true [])
theorem booleanDecision_represents (value : Represents v vc) : Represents (nativeBooleanDecision v) (booleanDecision vc) :=
  .app (.app (.constant rfl) (.app (.app testHeader_represents value) (Arithmetic.literal_represents 0))) (.constant rfl)

theorem BooleanLibrary.header_typed (library : BooleanLibrary env) (scalars : Arithmetic.Signatures env) :
    CastTyping env 0 (Arithmetic.SourceCasts env) ctx testHeader
      (.forallE wordType (.forallE wordType Arithmetic.boolType)) := by
  have word : DirectTyping env 0 ctx wordType (.sort (.succ .zero)) :=
    .constant scalars.word (by simp) rfl
  have bitvecInstance : DirectTyping env 0 ctx (.const ``instDecidableEqBitVec []) bitvecDecisionSignature.type :=
    .constant library.bitvecInstance (by simp) rfl
  have instanceType := DirectTyping.application bitvecInstance scalars.width_typed
  simp only [bitvecDecisionSignature,Arithmetic.natType,VExpr.inst,VExpr.instVar_zero] at instanceType
  have beq : CastTyping env 0 (Arithmetic.SourceCasts env) ctx (.const ``instBEqOfDecidableEq [.zero])
      (.forallE (.sort (.succ .zero)) (.forallE (.app (.const ``DecidableEq [.succ .zero]) (.bvar 0))
        (.app (.const ``BEq [.zero]) (.bvar 1)))) :=
    .constant library.beqInstance (by simp [VLevel.WF]) rfl
  have b1 := CastTyping.application beq (word.withCasts _)
  simp only [wordType,VExpr.inst,VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ,
    VExpr.lift,VExpr.liftN,Nat.reduceAdd] at b1
  have b2 := CastTyping.convertedApplication b1 (instanceType.withCasts _) (.decisionInstance library.decidableEq)
  have method : CastTyping env 0 (Arithmetic.SourceCasts env) ctx (.const ``bne [.zero])
      (.forallE (.sort (.succ .zero)) (.forallE (.app (.const ``BEq [.zero]) (.bvar 0))
        (.forallE (.bvar 1) (.forallE (.bvar 2) Arithmetic.boolType)))) :=
    .constant library.bneMethod (by simp [VLevel.WF]) rfl
  have m1 := CastTyping.application method (word.withCasts _)
  simp only [wordType,Arithmetic.boolType,VExpr.inst,VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ,
    VExpr.lift,VExpr.liftN,Nat.reduceAdd] at m1
  exact .application m1 b2

theorem BooleanLibrary.condition_typed (library : BooleanLibrary env) (scalars : Arithmetic.Signatures env)
    (value : CheckedTyping env 0 (Arithmetic.SourceCasts env) ctx v wordType) :
    CastTyping env 0 (Arithmetic.SourceCasts env) ctx (condition v) (.sort .zero) ∧
    CastTyping env 0 (Arithmetic.SourceCasts env) ctx (booleanDecision v)
      (.app (.const ``Decidable []) (condition v)) := by
  have applied := CastTyping.checkedApplication (library.header_typed scalars) value
  simp only [wordType,Arithmetic.boolType,VExpr.inst] at applied
  have zero := (scalars.literal_typed 0 (ctx := ctx)).mono (fun _ _ _ h => Arithmetic.SourceCasts.arithmetic (env := env) h)
  have test := CastTyping.application applied zero
  have boolean : CastTyping env 0 (Arithmetic.SourceCasts env) ctx Arithmetic.boolType (.sort (.succ .zero)) :=
    .constant library.boolean (by simp) rfl
  have truth : CastTyping env 0 (Arithmetic.SourceCasts env) ctx (.const ``Bool.true []) Arithmetic.boolType :=
    .constant library.truth (by simp) rfl
  have equality : CastTyping env 0 (Arithmetic.SourceCasts env) ctx (.const ``Eq [.succ .zero])
      (.forallE (.sort (.succ .zero)) (.forallE (.bvar 0) (.forallE (.bvar 1) (.sort .zero)))) :=
    .constant library.equality (by simp [VLevel.WF]) rfl
  have e1 := CastTyping.application equality boolean
  simp only [Arithmetic.boolType,VExpr.inst,VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ,
    VExpr.lift,VExpr.liftN,Nat.reduceAdd] at e1
  have e2 := CastTyping.application e1 test
  simp only [VExpr.inst] at e2
  have proposition := CastTyping.application e2 truth
  have instanceType : CastTyping env 0 (Arithmetic.SourceCasts env) ctx (.const ``instDecidableEqBool [])
      (.app (.const ``DecidableEq [.succ .zero]) Arithmetic.boolType) :=
    .constant library.boolInstance (by simp) rfl
  have d1 := CastTyping.functionApplication instanceType rfl
    (Arithmetic.SourceCasts.decisionFunction library.equality library.decidable library.boolean) test
  simp only [Arithmetic.decEqFunction,Arithmetic.boolType,applications,VExpr.inst,VExpr.instVar_lower,
    VExpr.instVar_zero,VExpr.instVar_succ,VExpr.lift,VExpr.liftN,Nat.reduceAdd] at d1
  refine ⟨proposition,?_⟩
  simpa only [booleanDecision,condition,equalValues,applications,VExpr.inst,
    VExpr.inst_lift,VExpr.instVar_zero] using CastTyping.application d1 truth

def choice (v decision yes no : VExpr) : VExpr := applications (.const ``ite [.succ .zero])
  [optionType stateType,condition v,decision,yes,no]
def source (v decision yes no : Lean.Expr) : Lean.Expr := Lean.mkApp5 (.const ``ite [.succ .zero])
  (option state) (nativeCondition v) decision yes no
theorem source_represents (vRep : Represents v vc) (dRep : Represents d dc)
    (aRep : Represents a ac) (bRep : Represents b bc) : Represents (source v d a b) (choice vc dc ac bc) := by
  exact app_represents (.constant rfl) (.cons (.app (.constant rfl) (.constant rfl))
    (.cons (condition_represents vRep) (.cons dRep (.cons aRep (.cons bRep .nil)))))

def scalarPremise : VExpr := equalValues (optionType wordType)
  (scalarValue (.bvar 8) (.bvar 7) (.bvar 6) (.bvar 5) (.bvar 4) (.bvar 11)) (someValue wordType (.bvar 3))
def leftPremise : VExpr := equalValues (optionType stateType)
  (bodyValue (.bvar 9) (.bvar 8) (.bvar 7) (.bvar 11) (.bvar 6) (.bvar 5)) (.bvar 2)
def rightPremise : VExpr := equalValues (optionType stateType)
  (bodyValue (.bvar 10) (.bvar 9) (.bvar 8) (.bvar 11) (.bvar 7) (.bvar 6)) (.bvar 2)
def resultType : VExpr := equalValues (optionType stateType)
  (bodyValue (.bvar 11) (.bvar 10) (.bvar 9)
    (applications (.const ``HybridWord.Cmd.branch []) [.bvar 14,.bvar 13,.bvar 12]) (.bvar 8) (.bvar 7))
  (choice (.bvar 6) (.bvar 5) (.bvar 4) (.bvar 3))
def signature : VExpr := .forallE exprType (.forallE cmdType (.forallE cmdType
  (inputsType (.forallE wordType (.forallE (.app (.const ``Decidable []) (condition (.bvar 0)))
    (.forallE (optionType stateType) (.forallE (optionType stateType)
      (.forallE scalarPremise (.forallE leftPremise (.forallE rightPremise resultType))))))))))
def constructorSignature : VExpr := .forallE exprType (.forallE cmdType (.forallE cmdType cmdType))
def iteSignature : VConstant := ⟨1,.forallE (.sort (.param 0)) (.forallE (.sort .zero)
  (.forallE (.app (.const ``Decidable []) (.bvar 0))
    (.forallE (.bvar 2) (.forallE (.bvar 3) (.bvar 4)))))⟩

theorem fact_typed (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts)
    {a : Piece env ctx p yes bodyExpected} (left : BodyCasts inputs a casts)
    {b : Piece env ctx p no bodyExpected} (right : BodyCasts inputs b casts)
    (decisionTyped : CheckedTyping env 0 casts ctx decision (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (registered : env.constants ``WordFrontendFacts.branch = some ⟨0,signature⟩) :
    CastTyping env 0 casts ctx
      (applications (.const ``WordFrontendFacts.branch [])
        ([e.represented.val,a.represented.val,b.represented.val] ++ inputs.args ++
          [value.sourceCore.val,decision,left.sourceCore.val,right.sourceCore.val,
            e.checked.proofCore.val,a.checked.proofCore.val,b.checked.proofCore.val]))
      (equalValues (optionType stateType)
        (bodyValue inputs.i.val inputs.x.val inputs.y.val
          (applications (.const ``HybridWord.Cmd.branch []) [e.represented.val,a.represented.val,b.represented.val])
          inputs.s.val inputs.ls.val)
        (choice value.sourceCore.val decision left.sourceCore.val right.sourceCore.val)) := by
  have fact : CastTyping env 0 casts ctx (.const ``WordFrontendFacts.branch []) signature :=
    by
      have h := CastTyping.constant (casts := casts) (ctx := ctx) (U := 0) (levels := [])
        registered (by simp) rfl
      simpa [signature,inputsType,scalarPremise,leftPremise,rightPremise,resultType,
        choice,condition,testHeader,Arithmetic.literalTerm,Arithmetic.width,
        exprType,cmdType,wordType,stateType,wordsType,equalValues,optionType,
        scalarValue,bodyValue,someValue,applications,VExpr.instL,VLevel.inst,numeral,
        Arithmetic.natType] using h
  have a1 := CastTyping.application fact value.target
  simp only [signature,inputsType,exprType,cmdType,wordType,stateType,wordsType,optionType,VExpr.inst] at a1
  have a2 := CastTyping.application a1 left.target
  simp only [VExpr.inst] at a2
  have a3 := CastTyping.application a2 right.target
  try simp only [VExpr.inst] at a3
  have a4 := inputs.apply_casts a3
  simp only [InputsTyped.instantiate,scalarPremise,leftPremise,rightPremise,resultType,choice,
    scalarValue,bodyValue,equalValues,someValue,optionType,stateType,wordType,applications,
    Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a4
  have a5 := CastTyping.checkedApplication a4 value.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a5
  have a6 := CastTyping.checkedApplication a5 decisionTyped
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a6
  have a7 := CastTyping.application a6 left.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a7
  have a8 := CastTyping.application a7 right.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a8
  have a9 := CastTyping.application a8 value.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a9
  have a10 := CastTyping.application a9 left.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a10
  have a11 := CastTyping.application a10 right.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a11
  simpa only [InputsTyped.args,applications,List.cons_append,List.nil_append,bodyValue,
    equalValues,optionType,stateType,choice] using a11

/-- Typing the existing Lean `ite`, shared by state branches, value selections,
and loop-body normalization. The result type is closed; the predicate need not be. -/
def iteValue (ty predicate decision yes no : VExpr) : VExpr :=
  applications (.const ``ite [.succ .zero]) [ty,predicate,decision,yes,no]

omit [Arithmetic.Includes casts] in
theorem ite_checked_typed (valueType : DirectTyping env 0 ctx ty (.sort (.succ .zero)))
    (closed : ty.ClosedN 0)
    (predicate : CastTyping env 0 casts ctx prop (.sort .zero))
    (decision : CheckedTyping env 0 casts ctx d (.app (.const ``Decidable []) prop))
    (left : CheckedTyping env 0 casts ctx a ty)
    (right : CheckedTyping env 0 casts ctx b ty)
    (registered : env.constants ``ite = some iteSignature) :
    CastTyping env 0 casts ctx (iteValue ty prop d a b) ty := by
  have fact : CastTyping env 0 casts ctx (.const ``ite [.succ .zero]) (iteSignature.type.instL [.succ .zero]) :=
    .constant registered (by simp [VLevel.WF]) rfl
  have a1 := CastTyping.application fact (valueType.withCasts casts)
  simp only [iteSignature,VExpr.instL,VLevel.inst,VExpr.inst,VExpr.instVar_zero,
    VExpr.instVar_succ,VExpr.instVar_lower,Nat.reduceAdd,List.map_nil,
    closed.lift_eq] at a1
  have a2 := CastTyping.application a1 predicate
  simp only [VExpr.inst,VExpr.instVar_zero,VExpr.instVar_succ,VExpr.instVar_lower,
    Nat.reduceAdd,List.map_nil,closed.instN_eq (Nat.zero_le _)] at a2
  have a3 := CastTyping.checkedApplication a2 decision
  simp only [VExpr.inst,closed.instN_eq (Nat.zero_le _)] at a3
  have a4 := CastTyping.checkedApplication a3 left
  simp only [VExpr.inst,closed.instN_eq (Nat.zero_le _)] at a4
  simpa only [closed.instN_eq (Nat.zero_le _)] using CastTyping.checkedApplication a4 right

omit [Arithmetic.Includes casts] in
theorem ite_typed (valueType : DirectTyping env 0 ctx ty (.sort (.succ .zero)))
    (closed : ty.ClosedN 0)
    (predicate : CastTyping env 0 casts ctx prop (.sort .zero))
    (decision : CastTyping env 0 casts ctx d (.app (.const ``Decidable []) prop))
    (left : CheckedTyping env 0 casts ctx a ty)
    (right : CheckedTyping env 0 casts ctx b ty)
    (registered : env.constants ``ite = some iteSignature) :
    CastTyping env 0 casts ctx (iteValue ty prop d a b) ty :=
  ite_checked_typed valueType closed predicate decision left right registered

omit [Arithmetic.Includes casts] in
theorem choice_typed (valueType : DirectTyping env 0 ctx (optionType stateType) (.sort (.succ .zero)))
    (predicate : CastTyping env 0 casts ctx (condition v) (.sort .zero))
    (decision : CastTyping env 0 casts ctx d (.app (.const ``Decidable []) (condition v)))
    (left : CastTyping env 0 casts ctx a (optionType stateType))
    (right : CastTyping env 0 casts ctx b (optionType stateType))
    (registered : env.constants ``ite = some iteSignature) :
    CastTyping env 0 casts ctx (choice v d a b) (optionType stateType) :=
  ite_typed valueType (by trivial) predicate decision left right registered

theorem finish_complete (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts)
    {a : Piece env ctx p yes bodyExpected} (left : BodyCasts inputs a casts)
    {b : Piece env ctx p no bodyExpected} (right : BodyCasts inputs b casts)
    (decisionRep : Represents d dc)
    (decisionTyped : CastTyping env 0 casts ctx dc (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (registered : env.constants ``WordFrontendFacts.branch = some ⟨0,signature⟩)
    (coverage : Conversion.Covers conv 0 casts) (exposure : Exposure env) :
    ∃ result, finish env conv exposure ctx
      (bodyExpected p (app ``HybridWord.Cmd.branch [e.code,a.code,b.code]) (source v d yes no))
      (app ``HybridWord.Cmd.branch [e.code,a.code,b.code])
      (app ``WordFrontendFacts.branch ([e.code,a.code,b.code] ++ p.args ++
        [v,d,yes,no,e.checked.proof,a.checked.proof,b.checked.proof]))
      (e.checked.known.orElse (a.checked.known.orElse b.checked.known)) = some result ∧
      CastTyping env 0 casts ctx result.proofCore.val result.core.val ∧
      result.code = app ``HybridWord.Cmd.branch [e.code,a.code,b.code] ∧
      result.proof = app ``WordFrontendFacts.branch ([e.code,a.code,b.code] ++ p.args ++
        [v,d,yes,no,e.checked.proof,a.checked.proof,b.checked.proof]) := by
  have targetRep := app_represents (f := Lean.Expr.const ``HybridWord.Cmd.branch []) (.constant rfl)
    (.cons e.represented.property (.cons a.represented.property (.cons b.represented.property .nil)))
  have proofRep := app_represents (f := Lean.Expr.const ``WordFrontendFacts.branch []) (.constant rfl)
    (.cons e.represented.property (.cons a.represented.property (.cons b.represented.property
      (.cons inputs.i.property (.cons inputs.x.property (.cons inputs.y.property
        (.cons inputs.s.property (.cons inputs.ls.property
          (.cons value.sourceCore.property (.cons decisionRep (.cons left.sourceCore.property
            (.cons right.sourceCore.property (.cons e.checked.proofCore.property
              (.cons a.checked.proofCore.property (.cons b.checked.proofCore.property .nil)))))))))))))))
  exact finish_cast_complete (bodyExpected_represents inputs targetRep
    (source_represents value.sourceCore.property decisionRep left.sourceCore.property right.sourceCore.property))
    proofRep (fact_typed inputs value left right decisionTyped registered)
    ((known_casts e.checked value.proof).orElse
      ((known_casts a.checked left.proof).orElse (known_casts b.checked right.proof))) coverage exposure _

/-- The native conditional parser composes its three arbitrary children, retaining
source typing, target typing, and certificate typing for enclosing constructs. -/
theorem branch_step_split_complete_code (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts proofCasts)
    {a : Piece env ctx p yes bodyExpected} (left : BodyCasts inputs a casts proofCasts)
    {b : Piece env ctx p no bodyExpected} (right : BodyCasts inputs b casts proofCasts)
    (decisionRep : Represents d dc)
    (predicateTyped : CastTyping env 0 casts ctx (condition value.sourceCore.val) (.sort .zero))
    (decisionTyped : CastTyping env 0 casts ctx dc (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (optionTyped : DirectTyping env 0 ctx (optionType stateType) (.sort (.succ .zero)))
    (iteDecl : env.constants ``ite = some iteSignature)
    (registered : env.constants ``WordFrontendFacts.branch = some ⟨0,signature⟩)
    (constructor : env.constants ``HybridWord.Cmd.branch = some ⟨0,constructorSignature⟩)
    (embeds : ∀ scope a b, casts scope a b → proofCasts scope a b)
    (coverage : Conversion.Covers conv 0 proofCasts) (exposure : Exposure env)
    (scalarCall : PieceParser env scalarExpected) (readCall : PieceParser env readExpected)
    (stepCall : StepParser env) (bodyCall : PieceParser env bodyExpected)
    (valueParsed : scalarCall ctx p v = some e)
    (leftParsed : bodyCall ctx p yes = some a)
    (rightParsed : bodyCall ctx p no = some b) :
    ∃ result, bodyStep env conv exposure scalarCall readCall stepCall bodyCall ctx p (source v d yes no) = some result ∧
      Nonempty (BodyCasts inputs result casts proofCasts) ∧ result.code = app ``HybridWord.Cmd.branch [e.code,a.code,b.code] := by
  obtain ⟨artifact,checked,proofTyped,_,_⟩ := finish_complete inputs (value.inProofCasts embeds) (left.inProofCasts embeds) (right.inProofCasts embeds) decisionRep (decisionTyped.mono embeds)
    registered coverage exposure
  let code := ClosedTerm.app ``HybridWord.Cmd.branch [e.closedTerm,a.closedTerm,b.closedTerm]
  let result : Piece env ctx p (source v d yes no) bodyExpected := ⟨code.val,artifact,code.closed,code.represented⟩
  refine ⟨result,?_,⟨⟨⟨_,source_represents value.sourceCore.property decisionRep
    left.sourceCore.property right.sourceCore.property⟩,?_,?_,proofTyped⟩⟩,rfl⟩
  · have reduced : leadingLet (source v d yes no) = none := rfl
    have head : (source v d yes no).getAppFn.constName? = some ``ite := rfl
    have args : (source v d yes no).getAppArgs.toList = [option state,nativeCondition v,d,yes,no] := rfl
    have test : nonzeroValue (nativeCondition v) = some v := rfl
    simp only [bodyStep,reduced,head,args,test,valueParsed,leftParsed,rightParsed,Option.bind_some]
    simp [source,Lean.mkApp5,code,result,ClosedTerm.app,ClosedTerm.const,Piece.closedTerm,app,
      valueParsed,leftParsed,rightParsed] at checked ⊢
    exact checked
  · exact choice_typed optionTyped predicateTyped decisionTyped left.value right.value iteDecl
  · have h : CastTyping env 0 casts ctx (.const ``HybridWord.Cmd.branch []) constructorSignature :=
      .constant constructor (by simp) rfl
    have a1 := CastTyping.application h value.target
    simp only [constructorSignature,exprType,cmdType,VExpr.inst] at a1
    have a2 := CastTyping.application a1 left.target
    simp only [VExpr.inst] at a2
    exact .application a2 right.target


theorem branch_step_split_complete (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts proofCasts)
    {a : Piece env ctx p yes bodyExpected} (left : BodyCasts inputs a casts proofCasts)
    {b : Piece env ctx p no bodyExpected} (right : BodyCasts inputs b casts proofCasts)
    (decisionRep : Represents d dc)
    (predicateTyped : CastTyping env 0 casts ctx (condition value.sourceCore.val) (.sort .zero))
    (decisionTyped : CastTyping env 0 casts ctx dc (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (optionTyped : DirectTyping env 0 ctx (optionType stateType) (.sort (.succ .zero)))
    (iteDecl : env.constants ``ite = some iteSignature)
    (registered : env.constants ``WordFrontendFacts.branch = some ⟨0,signature⟩)
    (constructor : env.constants ``HybridWord.Cmd.branch = some ⟨0,constructorSignature⟩)
    (embeds : ∀ scope a b, casts scope a b → proofCasts scope a b)
    (coverage : Conversion.Covers conv 0 proofCasts) (exposure : Exposure env)
    (scalarCall : PieceParser env scalarExpected) (readCall : PieceParser env readExpected)
    (stepCall : StepParser env) (bodyCall : PieceParser env bodyExpected)
    (valueParsed : scalarCall ctx p v = some e)
    (leftParsed : bodyCall ctx p yes = some a)
    (rightParsed : bodyCall ctx p no = some b) :
    ∃ result, bodyStep env conv exposure scalarCall readCall stepCall bodyCall ctx p (source v d yes no) = some result ∧
      Nonempty (BodyCasts inputs result casts proofCasts) := by
  obtain ⟨result,success,typed,_⟩ := branch_step_split_complete_code inputs value left right decisionRep
    predicateTyped decisionTyped optionTyped iteDecl registered constructor embeds coverage exposure
    scalarCall readCall stepCall bodyCall valueParsed leftParsed rightParsed
  exact ⟨result,success,typed⟩

theorem branch_step_complete (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts)
    {a : Piece env ctx p yes bodyExpected} (left : BodyCasts inputs a casts proofCasts)
    {b : Piece env ctx p no bodyExpected} (right : BodyCasts inputs b casts proofCasts)
    (decisionRep : Represents d dc)
    (predicateTyped : CastTyping env 0 casts ctx (condition value.sourceCore.val) (.sort .zero))
    (decisionTyped : CastTyping env 0 casts ctx dc (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (optionTyped : DirectTyping env 0 ctx (optionType stateType) (.sort (.succ .zero)))
    (iteDecl : env.constants ``ite = some iteSignature)
    (registered : env.constants ``WordFrontendFacts.branch = some ⟨0,signature⟩)
    (constructor : env.constants ``HybridWord.Cmd.branch = some ⟨0,constructorSignature⟩)
    (embeds : ∀ scope a b, casts scope a b → proofCasts scope a b)
    (coverage : Conversion.Covers conv 0 proofCasts) (exposure : Exposure env)
    (scalarCall : PieceParser env scalarExpected) (readCall : PieceParser env readExpected)
    (stepCall : StepParser env) (bodyCall : PieceParser env bodyExpected)
    (valueParsed : scalarCall ctx p v = some e)
    (leftParsed : bodyCall ctx p yes = some a)
    (rightParsed : bodyCall ctx p no = some b) :
    ∃ result, bodyStep env conv exposure scalarCall readCall stepCall bodyCall ctx p (source v d yes no) = some result ∧
      Nonempty (BodyCasts inputs result casts proofCasts) := by
  exact branch_step_split_complete inputs (value.mapProofs embeds) left right decisionRep
    predicateTyped decisionTyped optionTyped iteDecl registered constructor embeds coverage exposure
    scalarCall readCall stepCall bodyCall valueParsed leftParsed rightParsed

namespace Select

def choice (v decision yes no : VExpr) : VExpr := iteValue wordType (condition v) decision yes no
def source (v decision yes no : Lean.Expr) : Lean.Expr :=
  Lean.mkApp5 (.const ``ite [.succ .zero]) word (nativeCondition v) decision yes no
theorem source_represents (vRep : Represents v vc) (dRep : Represents d dc)
    (aRep : Represents a ac) (bRep : Represents b bc) : Represents (source v d a b) (choice vc dc ac bc) := by
  exact app_represents (.constant rfl) (.cons (.constant rfl)
    (.cons (condition_represents vRep) (.cons dRep (.cons aRep (.cons bRep .nil)))))

def leftPremise : VExpr := equalValues (optionType wordType)
  (scalarValue (.bvar 9) (.bvar 8) (.bvar 7) (.bvar 6) (.bvar 5) (.bvar 11)) (someValue wordType (.bvar 2))
def rightPremise : VExpr := equalValues (optionType wordType)
  (scalarValue (.bvar 10) (.bvar 9) (.bvar 8) (.bvar 7) (.bvar 6) (.bvar 11)) (someValue wordType (.bvar 2))
def resultType : VExpr := equalValues (optionType wordType)
  (scalarValue (.bvar 11) (.bvar 10) (.bvar 9) (.bvar 8) (.bvar 7)
    (applications (.const ``HybridWord.Expr.select []) [.bvar 14,.bvar 13,.bvar 12]))
  (someValue wordType (choice (.bvar 6) (.bvar 5) (.bvar 4) (.bvar 3)))
def signature : VExpr := .forallE exprType (.forallE exprType (.forallE exprType
  (inputsType (.forallE wordType (.forallE (.app (.const ``Decidable []) (condition (.bvar 0)))
    (.forallE wordType (.forallE wordType
      (.forallE scalarPremise (.forallE leftPremise (.forallE rightPremise resultType))))))))))
def constructorSignature : VExpr := .forallE exprType (.forallE exprType (.forallE exprType exprType))
theorem fact_typed (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts)
    {a : Piece env ctx p yes scalarExpected} (left : ScalarCasts inputs a casts)
    {b : Piece env ctx p no scalarExpected} (right : ScalarCasts inputs b casts)
    (decisionTyped : CheckedTyping env 0 casts ctx decision (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (registered : env.constants ``WordFrontendFacts.select = some ⟨0,signature⟩) :
    CastTyping env 0 casts ctx
      (applications (.const ``WordFrontendFacts.select [])
        ([e.represented.val,a.represented.val,b.represented.val] ++ inputs.args ++
          [value.sourceCore.val,decision,left.sourceCore.val,right.sourceCore.val,
            e.checked.proofCore.val,a.checked.proofCore.val,b.checked.proofCore.val]))
      (equalValues (optionType wordType)
        (scalarValue inputs.i.val inputs.x.val inputs.y.val inputs.s.val inputs.ls.val
          (applications (.const ``HybridWord.Expr.select []) [e.represented.val,a.represented.val,b.represented.val]))
        (someValue wordType (choice value.sourceCore.val decision left.sourceCore.val right.sourceCore.val))) := by
  have fact : CastTyping env 0 casts ctx (.const ``WordFrontendFacts.select []) signature :=
    by
      have h := CastTyping.constant (casts := casts) (ctx := ctx) (U := 0) (levels := [])
        registered (by simp) rfl
      simpa [signature,inputsType,scalarPremise,leftPremise,rightPremise,resultType,
        choice,iteValue,condition,testHeader,Arithmetic.literalTerm,Arithmetic.width,
        exprType,cmdType,wordType,stateType,wordsType,equalValues,optionType,
        scalarValue,bodyValue,someValue,applications,VExpr.instL,VLevel.inst,numeral,
        Arithmetic.natType] using h
  have a1 := CastTyping.application fact value.target
  simp only [signature,inputsType,exprType,cmdType,wordType,stateType,wordsType,optionType,VExpr.inst] at a1
  have a2 := CastTyping.application a1 left.target
  simp only [VExpr.inst] at a2
  have a3 := CastTyping.application a2 right.target
  try simp only [VExpr.inst] at a3
  have a4 := inputs.apply_casts a3
  simp only [InputsTyped.instantiate,scalarPremise,leftPremise,rightPremise,resultType,choice,iteValue,
    scalarValue,bodyValue,equalValues,someValue,optionType,stateType,wordType,applications,
    Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a4
  have a5 := CastTyping.checkedApplication a4 value.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a5
  have a6 := CastTyping.checkedApplication a5 decisionTyped
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a6
  have a7 := CastTyping.checkedApplication a6 left.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a7
  have a8 := CastTyping.checkedApplication a7 right.value
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a8
  have a9 := CastTyping.application a8 value.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a9
  have a10 := CastTyping.application a9 left.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a10
  have a11 := CastTyping.application a10 right.equality
  simp only [Nat.reduceAdd,← VExpr.lift_instN_lo,VExpr.inst_lift,condition_inst,VExpr.inst,
    VExpr.instVar_lower,VExpr.instVar_zero,VExpr.instVar_succ] at a11
  simpa only [InputsTyped.args,applications,List.cons_append,List.nil_append,bodyValue,
    equalValues,optionType,stateType,wordType,someValue,choice,iteValue,scalarValue] using a11

theorem finish_complete (inputs : InputsTyped env ctx p)
    {e : Piece env ctx p v scalarExpected} (value : ScalarCasts inputs e casts)
    {a : Piece env ctx p yes scalarExpected} (left : ScalarCasts inputs a casts)
    {b : Piece env ctx p no scalarExpected} (right : ScalarCasts inputs b casts)
    (decisionRep : Represents d dc)
    (decisionTyped : CastTyping env 0 casts ctx dc (.app (.const ``Decidable []) (condition value.sourceCore.val)))
    (registered : env.constants ``WordFrontendFacts.select = some ⟨0,signature⟩)
    (coverage : Conversion.Covers conv 0 casts) (exposure : Exposure env) :
    ∃ result, finish env conv exposure ctx
      (scalarExpected p (app ``HybridWord.Expr.select [e.code,a.code,b.code]) (source v d yes no))
      (app ``HybridWord.Expr.select [e.code,a.code,b.code])
      (app ``WordFrontendFacts.select ([e.code,a.code,b.code] ++ p.args ++
        [v,d,yes,no,e.checked.proof,a.checked.proof,b.checked.proof]))
      (e.checked.known.orElse (a.checked.known.orElse b.checked.known)) = some result ∧
      CastTyping env 0 casts ctx result.proofCore.val result.core.val ∧
      result.code = app ``HybridWord.Expr.select [e.code,a.code,b.code] ∧
      result.proof = app ``WordFrontendFacts.select ([e.code,a.code,b.code] ++ p.args ++
        [v,d,yes,no,e.checked.proof,a.checked.proof,b.checked.proof]) := by
  have targetRep := app_represents (f := Lean.Expr.const ``HybridWord.Expr.select []) (.constant rfl)
    (.cons e.represented.property (.cons a.represented.property (.cons b.represented.property .nil)))
  have proofRep := app_represents (f := Lean.Expr.const ``WordFrontendFacts.select []) (.constant rfl)
    (.cons e.represented.property (.cons a.represented.property (.cons b.represented.property
      (.cons inputs.i.property (.cons inputs.x.property (.cons inputs.y.property
        (.cons inputs.s.property (.cons inputs.ls.property
          (.cons value.sourceCore.property (.cons decisionRep (.cons left.sourceCore.property
            (.cons right.sourceCore.property (.cons e.checked.proofCore.property
              (.cons a.checked.proofCore.property (.cons b.checked.proofCore.property .nil)))))))))))))))
  exact finish_cast_complete (scalarExpected_represents inputs targetRep
    (source_represents value.sourceCore.property decisionRep left.sourceCore.property right.sourceCore.property))
    proofRep (fact_typed inputs value left right decisionTyped registered)
    ((known_casts e.checked value.proof).orElse
      ((known_casts a.checked left.proof).orElse (known_casts b.checked right.proof))) coverage exposure _


